# Copy to .env and adjust for your deployment.
# Docker Compose reads this file automatically (values below are the defaults).

# Base URL of the backend as seen by the BROWSER (not by the container)
VITE_API_URL=http://localhost:8000/api/v1

# Origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# MUST be changed for anything non-local (>= 32 chars)
JWT_SECRET_KEY=change-me-to-a-random-64-char-string
